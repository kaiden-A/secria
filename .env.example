# Secria environment template.
# Copy to .env and fill in real values. Never commit .env.

# --- Database -----------------------------------------------------------------
# Neon pooled connection string (the API uses this).
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require
# Optional direct connection for Alembic. Leave empty to use DATABASE_URL.
DATABASE_URL_DIRECT=
DB_SCHEMA=public

# --- Application secrets ------------------------------------------------------
# Signs the short-lived OAuth handshake cookie. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=change-me
# 32 random bytes, base64. Generate with:
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# Back this up somewhere other than the database. Losing it loses every secret.
SECRIA_MASTER_KEY=
SECRIA_MASTER_KEY_VERSION=1

# --- Web / API wiring ---------------------------------------------------------
API_BASE_URL=http://localhost:8000
APP_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
SECRIA_SESSION_COOKIE_NAME=secria_session
SESSION_TTL_DAYS=30
COOKIE_SECURE=false
RATE_LIMIT_ENABLED=true
LOG_LEVEL=INFO

# --- Zitadel ------------------------------------------------------------------
ZITADEL_ISSUER=https://your-instance.zitadel.cloud
# Web app: public PKCE client.
ZITADEL_CLIENT_ID=
# Optional: a separate Native app with the Device Code grant for the CLI.
# Leave empty to reuse ZITADEL_CLIENT_ID for both web and CLI.
ZITADEL_CLI_CLIENT_ID=
ZITADEL_REDIRECT_URI=http://localhost:3000/api/auth/callback
ZITADEL_POST_LOGOUT_URI=http://localhost:3000/login
# Optional: expected audience when the CLI sends an access token instead of an
# ID token. The API always accepts both the web and CLI client IDs.
ZITADEL_API_AUDIENCE=

# --- Email (Resend) -----------------------------------------------------------
# Empty key = emails are rendered and logged, never sent.
RESEND_API_KEY=
EMAIL_FROM="Secria <secria@example.com>"
EMAIL_REPLY_TO=
EMAIL_OVERRIDE_TO=

# --- CORS ---------------------------------------------------------------------
# Comma-separated origins for direct API clients. The web app is same-origin
# through the Next rewrite and does not need this.
CORS_ORIGINS=
